# 复制为 .env 并填入你的配置
# cp .env.example .env

# ── 方案A：使用 yoka（你们当前的 Hermes 配置） ──────────────────────
ANTHROPIC_API_KEY=sk-...                          # yoka 的 API Key
ANTHROPIC_BASE_URL=https://aicoding.dobest.com    # yoka endpoint
ARGUS_MODEL=claude-sonnet-4-6@default             # 或 claude-opus-4-6@default / gpt-5.4

# ── 方案B：使用官方 Anthropic ──────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# 不需要设置 ANTHROPIC_BASE_URL（注释掉即可）
# ARGUS_MODEL=claude-sonnet-4-5-20250929

# ── 方案C：使用 OpenAI ─────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
